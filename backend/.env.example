# Copia a .env (local sin Docker) o usa .env.docker.example para Docker Compose
# Setup rápido Docker: .\scripts\setup-env.ps1

SECRET_KEY=django-insecure-cambia-esto-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
PORT=8000

CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Cache + Channels (WebSockets). Obligatoria en producción con >1 worker ASGI.
# REDIS_URL=redis://localhost:6379/0
# Tickets WS de un solo uso (POST /api/realtime/ws-ticket/).
# WS_TICKET_TTL_SECONDS=60
# Durante rollout con apps viejas (?token=): WS_LEGACY_JWT_QUERY_AUTH=true
# Después de adopción: WS_LEGACY_JWT_QUERY_AUTH=false
# WS_TICKETS_REQUIRE_REDIS=true

USE_SQLITE=True

# PostgreSQL local (Windows suele usar puerto 5433; Docker publica 5433→5432)
# Setup: .\scripts\setup-postgres-local.ps1
DB_NAME=zinapp_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5433

SERVE_MEDIA=True
API_DOCS_ENABLED=True
SEED_DATA=false
# Required together with SEED_DATA for ephemeral demo environments only.
ALLOW_DEMO_SEED=false

API_DOMAIN=localhost

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_BACK_URL=
MERCADOPAGO_WEBHOOK_URL=
# Obtain this secret from Mercado Pago's webhook configuration.
MERCADOPAGO_WEBHOOK_SECRET=

# Stripe Checkout (pago en línea activo)
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://zinapp.com.mx/app/
STRIPE_CANCEL_URL=https://zinapp.com.mx/app/
# Opcional: fallback si no defines SUCCESS/CANCEL
STRIPE_BACK_URL=https://zinapp.com.mx/app/

CRON_SECRET=

# Email — recuperación de contraseña (Resend API HTTP; evita cuelgues SMTP)
# https://resend.com → API Keys
# Sin dominio verificado: DEFAULT_FROM_EMAIL=ZinApp <onboarding@resend.dev>
#   (solo llega al email de tu cuenta Resend).
# Con dominio zinapp.com.mx verificado: ZinApp <noreply@zinapp.com.mx>
RESEND_API_KEY=
# Compat opcional (si EMAIL_HOST es resend.com, EMAIL_HOST_PASSWORD se usa como API key HTTP)
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=ZinApp <onboarding@resend.dev>

# Landing (/): app web, WhatsApp y contacto opcional
LANDING_APP_URL=https://zinapp.com.mx/app/
SITE_URL=https://zinapp.com.mx
APP_STORE_URL=https://apps.apple.com/app/id6789001540
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.zinapp.delivery
# false = muestra “Usar ZinApp en Android” (web) en lugar del botón de Play
GOOGLE_PLAY_ENABLED=false
# 301 de hosts Railway/Render → SITE_URL solo para landing/SEO
CANONICAL_HOST_REDIRECT=true
# Opcional: hosts exactos a redirigir (vacío = *.railway.app / *.onrender.com)
CANONICAL_REDIRECT_HOSTS=
# true = muestra conteos reales de negocios/pedidos en confianza (si hay datos)
LANDING_SHOW_LIVE_STATS=false
SUPPORT_WHATSAPP=4439353160
SUPPORT_EMAIL=
SUPPORT_PHONE=4439353160
SOCIAL_INSTAGRAM=
SOCIAL_FACEBOOK=
TERMS_URL=

# Producción real: DEMO_ACCOUNTS_ENABLED=false
DEMO_ACCOUNTS_ENABLED=True

# Google Sign-In (OAuth Client ID tipo Web; varios separados por coma)
# https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_IDS=

# Expo Push (opcional pero recomendado en producción)
# https://expo.dev/settings/access-tokens
EXPO_ACCESS_TOKEN=
# PUSH_ASYNC_RECEIPT_CHECK=true
# PUSH_RECEIPT_CHECK_DELAY_SEC=20
